# Copy to .env.local for local overrides (.env* is gitignored except this file).
# Only VITE_-prefixed vars reach the browser bundle -- never put secrets here.

# Base URL the API client prepends to every request.
# Leave empty in development: requests stay relative and Vite proxies
# /api and /health to the backend, so dev is same-origin (no CORS).
# In production set the deployed API origin, e.g. https://api.lightnwonder.com
VITE_API_BASE_URL=

# Request timeout in milliseconds.
VITE_API_TIMEOUT_MS=15000

# Send cookies with cross-origin API requests. Only needed when the API lives on
# a different origin and uses cookie auth.
VITE_API_WITH_CREDENTIALS=false

# Where the Vite dev-server proxy forwards /api and /health.
# Not VITE_-prefixed: this is build-time only and never shipped to the browser.
BACKEND_PROXY_TARGET=http://127.0.0.1:8001
