# Copy to .env and adjust. .env is gitignored; never commit real secrets.

# --- Application ---
APP_NAME="LightNWonder API"
APP_VERSION=0.1.0
# local | development | staging | production
ENVIRONMENT=local
DEBUG=true

# --- Server ---
HOST=0.0.0.0
PORT=8001
RELOAD=true

# --- API ---
API_PREFIX=/api

# --- Database -------------------------------------------------------------
# Keep the real Neon/PostgreSQL URL in .env or your deployment secret store.
# The app opens a connection pool at startup; it does not manage schemas or
# tables.
DATABASE_URL=

# --- Agentic workflows (LangChain + LangGraph) ----------------------------
# Disabled by default: placeholder values below are safe examples only. Set
# AGENT_ENABLED=true only after replacing the selected provider credential.
AGENT_ENABLED=false
AGENT_NAME=lightnwonder_agent
# LangChain provider:model notation. Examples:
#   openai:gpt-4o-mini
#   anthropic:claude-sonnet-4-6
AGENT_MODEL=openai:gpt-4o-mini
# Leave empty when AGENT_MODEL includes the provider prefix.
AGENT_PROVIDER=
# Generic credential override. Providers with another keyword can set
# AGENT_API_KEY_PARAM (for example google_api_key).
AGENT_API_KEY=dummy-replace-with-real-key
AGENT_API_KEY_PARAM=api_key
AGENT_BASE_URL=
AGENT_TEMPERATURE=0.0
AGENT_MAX_TOKENS=2048
AGENT_TIMEOUT_SECONDS=60.0
AGENT_MAX_RETRIES=2
AGENT_RECURSION_LIMIT=50
AGENT_SYSTEM_PROMPT="You are a reliable assistant. Use available tools deliberately, explain uncertainty, and never invent tool results."

# Provider-specific placeholders are included for integrations that read their
# own conventional variable instead of AGENT_API_KEY.
OPENAI_API_KEY=sk-dummy-replace-with-real-key
ANTHROPIC_API_KEY=sk-ant-dummy-replace-with-real-key

# Short-term memory: memory is convenient locally; postgres is durable. When
# postgres is selected, AGENT_CHECKPOINT_URL falls back to DATABASE_URL.
AGENT_CHECKPOINT_BACKEND=memory
AGENT_CHECKPOINT_URL=
AGENT_CHECKPOINT_SETUP=false

# Optional LangSmith tracing. Leave disabled until a real LangSmith key exists.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=dummy-replace-with-real-key
LANGCHAIN_PROJECT=lightnwonder-local

# --- CORS ---
# Comma-separated list. Must include the frontend dev server origin.
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
CORS_ALLOW_CREDENTIALS=true

# --- Observability ---
# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO
# true emits single-line JSON logs; use in deployed environments
LOG_JSON=false
REQUEST_ID_HEADER=X-Request-ID

# --- OBS Studio ---
# obs-websocket v5 ships with OBS Studio 28+. Turn the server on under
# Tools > WebSocket Server Settings, then paste its password below.
OBS_HOST=127.0.0.1
OBS_PORT=4455
OBS_PASSWORD=
# true connects at startup; a failure is logged and never fatal.
OBS_AUTO_CONNECT=false
OBS_CONNECT_TIMEOUT_SECONDS=5.0
OBS_REQUEST_TIMEOUT_SECONDS=10.0
# Default root for screenshots and recordings, relative to backend/.
OBS_CAPTURE_DIR=obs-captured-files
# Optional independent roots; each falls back to OBS_CAPTURE_DIR when omitted.
# OBS_SCREENSHOT_DIR=C:\captures\screenshots
# OBS_RECORDING_DIR=C:\captures\recordings
# A request can additionally provide output_dir as a relative use-case folder
# below the corresponding root, such as ir-inspection/session-01.
# Subdirectory of the screenshot root the dashboard's Screenshot button writes
# into, and the one the ROI extractor reads its newest frame from.
OBS_SCREENSHOT_SUBDIR=screenshots
# true points OBS's recording directory at the configured recording root on
# connect and on recording starts without an explicit output_dir. This change
# persists in your OBS profile after the app exits. Explicit output_dir values
# are always applied.
OBS_SET_RECORD_DIRECTORY=true

# --- Virtual OLED i-deck ---
# The emulated button deck for a game running in a simulator, served by
# OledPanelSvc.exe as an SDL window. Presses are posted to that window as mouse
# messages, so the physical cursor never moves.
#
# IMPORTANT: Windows blocks input sent from a lower integrity level to a higher
# one (UIPI). If the panel was launched elevated, this backend must be started
# elevated too, or every press is refused. GET /api/ideck/status reports
# "access_denied" when that is the case.
IDECK_WINDOW_TITLE=Virtual OLED
IDECK_WINDOW_CLASS=SDL_app
# Button geometry is read from the panel's own layout file, so it is never
# restated here. The panel service logs which file it chose on startup.
IDECK_PANEL_XML=C:\ssd\cabinet\deployment\cfg\ButtonPanel\virtual_oled.xml
# The panel's log. Every press it accepts appears as "Button Pressed ID=<hex>",
# which is how a press is confirmed rather than assumed.
IDECK_LOG_PATH=C:\logs\OledPanelSvc.log
# The initial game choice is stored in
# app/config/game_config/active_game.json. The dashboard can change it at
# runtime, while all game-specific settings live in games/<name>.json.
# Where those files live. Game configs ship with the code, so the default is
# resolved inside the app package and works from any working directory; leave
# this unset unless you keep game configs somewhere else. A relative value is
# taken as relative to the `app` package, not to backend/.
# IDECK_GAME_CONFIG_DIR=C:\deployment\game_configs
# Hold between button-down and button-up; a real press measures ~200ms.
IDECK_PRESS_HOLD_SECONDS=0.12
# false returns success as soon as a press is posted, without confirming it.
IDECK_VERIFY_PRESSES=true
IDECK_VERIFY_TIMEOUT_SECONDS=2.0
# A minimized window has no client area to aim at, so it is restored first --
# without activating it, so focus is left alone.
IDECK_RESTORE_IF_MINIMIZED=true
# SDL can swallow the first click on an unfocused window. When a press goes
# unconfirmed, foreground the panel and try once more. Still no cursor movement.
IDECK_FOCUS_ON_RETRY=true

# --- Event Based Capture ---------------------------------------------------
# Follows the active game's log (the "log" key in games/<name>.json) and takes
# an OBS screenshot for every gameplay event it recognises. Runs are written to
# a dated folder below the OBS screenshot root, one per Start/Stop.
# Subfolder of the OBS screenshot root that holds one directory per run.
EVENT_CAPTURE_DIR_NAME=event-capture
# How often the log is read. This is the delay between an event and its
# screenshot, not a limit on how many events can be captured.
EVENT_CAPTURE_POLL_SECONDS=0.25
# One event is often logged twice within milliseconds -- once as the message
# published, once as the state transition it caused. Repeats of the same event
# closer together than this are treated as one. Measured against real logs:
# 0.3s collapses the duplicates while keeping every genuine spin.
EVENT_CAPTURE_DEBOUNCE_SECONDS=0.3
# Screenshots are evidence, not masters; full resolution is several MB each.
EVENT_CAPTURE_SCREENSHOT_WIDTH=1280
# A run left going overnight should not fill the disk. Past this, events are
# still recorded but stop taking screenshots.
EVENT_CAPTURE_MAX_EVENTS=2000
# How many recent events GET /api/event-capture/status reports for the card.
EVENT_CAPTURE_RECENT_EVENTS=5

# --- Game window input -----------------------------------------------------
# Clicks the simulator's own Unity window, for the on-screen buttons the button
# deck does not carry -- take win and gamble are touched on the glass, not
# pressed on the i-deck, which is why they are unreachable through IDECK_*.
#
# Where to click comes only from the active game's "button_targets" block in
# games/<name>.json, as fractions of the window, so nothing is hardcoded here
# and a resized simulator needs no re-measurement.
#
# IMPORTANT: the same UIPI rule as the i-deck applies. Windows blocks input sent
# from a lower integrity level to a higher one, so if the game was launched
# elevated this backend must be too. GET /api/game-input/status reports
# "access_denied" when that is the case.
#
# Blank takes the window title from the active game config, which is what the
# simulator titles its window ("FortuneOx"). Set it only if that is not true.
GAME_INPUT_WINDOW_TITLE=
# Every Unity standalone player uses this class. Pinning it stops a same-named
# window belonging to something else from being driven by mistake.
GAME_INPUT_WINDOW_CLASS=UnityWndClass
# Hold between button-down and button-up. The game reacts on the up, so this
# only has to be long enough for both to be pumped in order.
GAME_INPUT_CLICK_HOLD_SECONDS=0.08
# false returns success as soon as a click is posted, without confirming it.
# Leave it on: a coordinate that has drifted lands on nothing, and the game
# logs no error -- silence is the only symptom, so silence has to be a failure.
GAME_INPUT_VERIFY_CLICKS=true
# The game publishes its decision in the same millisecond it takes the touch,
# so this is headroom for log flushing rather than for the game itself.
GAME_INPUT_VERIFY_TIMEOUT_SECONDS=2.0
# A minimized window has no client area to aim at, so it is restored first --
# without activating it, so focus is left alone.
GAME_INPUT_RESTORE_IF_MINIMIZED=true
# A window that has never been focused can swallow the first posted click. When
# one goes unconfirmed, foreground the game and try once more. No cursor moves.
GAME_INPUT_FOCUS_ON_RETRY=true

# --- OCR (Tesseract) -------------------------------------------------------
# Reads the game's on-screen text out of the regions the active game declares in
# its "roi" block. Tesseract is an external program, not a pip package: install
# it once per machine (winget install --id UB-Mannheim.TesseractOCR).
#
# IMPORTANT: the Windows installer does not put tesseract.exe on PATH, so the
# backend looks where the installers put it -- %LOCALAPPDATA%\Tesseract-OCR,
# %LOCALAPPDATA%\Programs\Tesseract-OCR, %PROGRAMFILES%\Tesseract-OCR and the
# x86 form -- after checking PATH. GET /api/ocr/status reports which it found, or
# every path it looked in. Nothing fails without an engine; only a read is
# refused, the same way a closed OBS does not make the service unhealthy.
#
# false answers every OCR request with "disabled" without looking for the binary.
OCR_ENABLED=true
# Set only for an install somewhere else. The folder is accepted as well as the
# .exe, because the folder is what the installer shows you.
# OCR_TESSERACT_CMD=C:\Users\you\AppData\Local\Tesseract-OCR\tesseract.exe
# Where <lang>.traineddata lives. Unset uses the tessdata beside the executable,
# which is what an installer sets up.
# OCR_TESSDATA_DIR=C:\Tesseract-OCR\tessdata
# Language, as the traineddata filename; several combine as "eng+deu".
OCR_LANGUAGE=eng
# Page segmentation mode. 7 is "a single text line", which is what a meter is;
# 6 for a block of lines, 11 for scattered text, 3 for a whole page. Per-region
# overrides belong in the game config's "ocr" block, not here.
OCR_PSM=7
# OCR engine mode; 3 is the LSTM engine on a 5.x install.
OCR_OEM=3
# Characters to restrict the engine to. Empty means no restriction. Under the
# LSTM engine this is a strong hint rather than a rule, and on this project's
# meters a digits-only list sometimes joins two values into one -- so it is off
# by default and worth setting per region rather than globally.
OCR_CHAR_WHITELIST=
# Preprocessing, applied to the crop before the engine sees it. Measured on this
# project's captures: at 1x the cash meter reads as nothing, at 3x it reads.
OCR_UPSCALE=3.0
OCR_GRAYSCALE=true
# Stretches the crop's range to full black-to-white; meters are drawn over
# artwork and rarely reach either end on their own.
OCR_AUTOCONTRAST=true
# Tesseract 5 copes with light-on-dark text, so this is a per-region knob for a
# region where it does not.
OCR_INVERT=false
# Binarize at this grey level, 0-255. Unset leaves Tesseract's own adaptive
# thresholding, which is usually better on anti-aliased glyphs.
# OCR_THRESHOLD=128
# Reported to the engine instead of letting it guess from a small image, which is
# what its "Estimating resolution" warnings are.
OCR_DPI=300
# A read is a subprocess, and a subprocess can hang.
OCR_TIMEOUT_SECONDS=15.0
# Width of the OBS screenshot taken for a live read. Unset means native
# resolution: this frame exists only to be read, and a pixel dropped here is one
# the engine never gets.
# OCR_SCREENSHOT_WIDTH=1920

# --- Captured-frame geometry -------------------------------------------------
# Every configured region -- ROI, OCR and the reel grid -- is fractions of the
# part of the frame the game fills, not of the canvas OBS wrote. OBS fits the
# window capture inside its canvas, so a portrait simulator arrives with black
# bars whose width depends on the window's shape at that moment; trimming them
# is what lets one set of numbers work at every window size.
# Off puts every region back on the whole canvas, which is what a capture that
# is already edge to edge gets either way.
FRAME_LETTERBOX_TRIM=true
# Luminance a pixel must exceed to count as game rather than bar, 0-255. OBS
# pads with pure black and the games' own edges come in above 180.
FRAME_LETTERBOX_THRESHOLD=8
# Smallest content box that will be believed, per axis, as a fraction of the
# frame. Anything smaller is read as a dark game screen -- a fade, a loading
# frame -- and the whole frame is used instead.
FRAME_LETTERBOX_MIN_FRACTION=0.25

# --- Payline check -----------------------------------------------------------
# Two tiles of a split reel grid are read as the same symbol when their cosine
# similarity reaches this. Pixel channels are non-negative, so the measure does
# NOT start at zero for unrelated pictures: on this project's captures two
# different symbols sharing one reel background score 0.60 to 0.89, and two crops
# of the SAME symbol -- differing only by the glow and slight scaling the game
# animates them with -- score 0.967 and up. The gap is wide but it is much higher
# up the range than "0.7 means similar" suggests, so tune this against a frame
# that does not move rather than by intuition -- `stats.matched_min` and
# `stats.rejected_max` on a check are the two numbers a working cut sits between.
PAYLINE_MATCH_THRESHOLD=0.86
# Bet configuration to check when a request names none, as the game config keys
# it -- "5", "20", "40". Empty means the numerically smallest the game declares,
# which is the five-line set for every game shipped so far. A set the active game
# does not declare falls back to that rather than failing, because this setting is
# deployment-wide and the games are not all the same.
PAYLINE_DEFAULT_SET=
# Width the reels crop is enlarged to before the lines are drawn on it. A
# 1280x720 capture leaves reels around 455 pixels wide, on which a stroke thick
# enough to see covers the symbol it is pointing at.
PAYLINE_OVERLAY_MIN_WIDTH=960

# --- Paytable ---------------------------------------------------------------
# Which paytable a game has loaded is read out of the game's own log, backwards
# from the end: it writes `current paytableId[...]` on every denomination change,
# and that string is the name of the directory its maths lives in. WHERE that
# directory is belongs to the game, not to the environment, so it lives in the
# game config's `game_config` key rather than here.
#
# How far back from the end of the log to look for that line. The newest one is
# normally in the final few kilobytes; the rest of this is for a session that has
# not changed denomination in a long while. 0 scans the whole file.
PAYTABLE_LOG_SCAN_BYTES=8388608
# Cap on the stops sent back per reel strip. A strip is 100-200 long and every
# strip of every set travels in one response, so this is a backstop against a
# pathological file rather than a page size -- a strip cut short by it is
# reported as `truncated`, never silently shortened.
PAYTABLE_MAX_STRIP_STOPS=1000

# --- Analyze Spin ------------------------------------------------------------
# One press drives a whole spin -- record, screenshot, spin, wait, collect,
# screenshot -- and then validates the cash meter and the paylines over what it
# produced. Everything here is either which key does what, or how long a stage
# may take; the numbers bound waits on the GAME'S OWN LOG, not on the network, so
# they are generous by design: a spin that never lands should end as a named
# failure on one step rather than a request that hangs.
#
# Directory under the capture root holding one folder per run (its `run.json`),
# and the matching subdirectory under the recording root for its video.
ANALYZE_SPIN_DIR_NAME=analyze-spin
# The i-deck key that spins, as `IDECK_PANEL_XML` names it -- a layout id
# belonging to the cabinet, not a game concept. FortuneOx binds `Rebet` to
# SpinButtonMsg; `GET /api/ideck/buttons` lists what is pressable.
ANALYZE_SPIN_SPIN_BUTTON=Rebet
# The `button_targets` entry clicked to collect a win. Take-win is not one of the
# deck's fourteen keys, so it is a click into the game's own window.
ANALYZE_SPIN_TAKE_WIN_TARGET=take_win
# Default for a run that leaves `record` off its /start request. Off by
# default; the dashboard's toggle overrides this per run.
ANALYZE_SPIN_RECORD=false
# How often the game log is re-read while waiting for the next event. Also the
# granularity a cancel lands at.
ANALYZE_SPIN_POLL_SECONDS=0.1
# A confirmed i-deck press proves the PANEL saw the key, not that the game acted
# on it -- the deck's layout belongs to the cabinet, so a key the panel confirms
# may be one this game binds nothing to. So the spin is not considered started
# until the game publishes SpinButtonMsg, and this bounds that wait.
ANALYZE_SPIN_SPIN_TIMEOUT_SECONDS=10.0
# Reel spin plus every stop delay the theme adds.
ANALYZE_SPIN_REELS_TIMEOUT_SECONDS=60.0
# How long to wait for the win meter to finish counting up before calling the
# spin a loss. THE ONE NUMBER HERE THAT CAN PRODUCE A CONFIDENTLY WRONG ANSWER:
# there is no log line saying a spin lost, so a loss is proven by this wait
# running out, and one set below the game's longest count-up reports a win as a
# loss. Too long only costs a losing spin the wait.
ANALYZE_SPIN_WIN_WAIT_SECONDS=10.0
# Breathing room between the win meter settling and the screenshot of it.
ANALYZE_SPIN_WIN_SETTLE_SECONDS=0.5
# After OBS is re-pointed at the game's window, before the first screenshot.
# Re-pointing a window capture makes OBS render nothing for a moment, and a
# screenshot taken inside that window comes back black -- which is an error
# nowhere and quietly invalidates every reading taken off the frame.
ANALYZE_SPIN_SOURCE_SETTLE_SECONDS=1.0
# A frame with nothing in it is read back, retried and then reported rather than
# accepted, since OBS reports a successful write either way.
ANALYZE_SPIN_BLANK_RETRIES=2
ANALYZE_SPIN_BLANK_RETRY_SECONDS=0.75
# Between a confirmed take-win and the screenshot proving it landed. The click is
# proven by the log; the balance moving is an animation.
ANALYZE_SPIN_COLLECT_SETTLE_SECONDS=1.5
# Screenshot width, or empty for the OBS canvas's own. Left native by default:
# the same frames are cropped for meter OCR and split into symbol tiles, and both
# lose more to a downscale than the file size is worth.
ANALYZE_SPIN_SCREENSHOT_WIDTH=
# How far two meter readings may differ and still be called equal. Cash is drawn
# to two decimals, so this absorbs the OCR of the last one and nothing larger.
ANALYZE_SPIN_METER_TOLERANCE=0.005
# Recognised log events kept on one run's record, so a game that logs
# continuously cannot grow it without bound.
ANALYZE_SPIN_MAX_EVENTS=200
# Which visible row the game's logged reel stop refers to. The stops are used to
# NAME the symbols of a run cosine similarity already found -- never to decide
# what paid -- so this only affects whether an award comes out exact or as a
# range. `auto` builds all three readings and keeps whichever agrees best with
# the matches measured off the picture, which is the only evidence there is: the
# maths files state the stop index and never the convention, and the wrong one
# shifts every symbol by a row into a plausible grid of the wrong spin. Pin it to
# top/middle/bottom once a game's alignment is known and settled.
ANALYZE_SPIN_REEL_STOP_ANCHOR=auto
